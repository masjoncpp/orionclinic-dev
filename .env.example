#--------------------------------------------------------------------
# Orion Clinic - Environment Configuration Template (Docker & Local)
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# Port & URL Aplikasi
APP_PORT = 8080
APP_BASE_URL = 'http://localhost:8080/'
app.baseURL = 'http://localhost:8080/'

# Konfigurasi Container Database (Docker Compose)
DB_HOST = db
DB_PORT = 3306
DB_FORWARD_PORT = 3307
DB_DATABASE = orionclinic
DB_USERNAME = orionclinic
DB_PASSWORD = orionclinic_dev
DB_ROOT_PASSWORD = orionclinic_root_dev

# Konfigurasi Database CodeIgniter 4
database.default.hostname = db
database.default.database = orionclinic
database.default.username = orionclinic
database.default.password = orionclinic_dev
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
